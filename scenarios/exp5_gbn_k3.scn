# Experiment 5: Deterministic Go-Back-N sequence-number limit test for k=3 (2^3 = 8)
# Drops the first ACK for every sequence number 0..7.
# GBN works intact for W in {1..7}, and fails deterministically at W = 8 (2^k).
link_rate_bps = 1000000
queue_capacity = 128
prop_delay_ms = 20
jitter_ms = 0
data_loss = 0
ack_loss = 0
corrupt = 0
duplicate = 0
reorder = 0
reorder_timeout_ms = 50

action R2S seq 0 occ 1 drop
action R2S seq 1 occ 1 drop
action R2S seq 2 occ 1 drop
action R2S seq 3 occ 1 drop
action R2S seq 4 occ 1 drop
action R2S seq 5 occ 1 drop
action R2S seq 6 occ 1 drop
action R2S seq 7 occ 1 drop
